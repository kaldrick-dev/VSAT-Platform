generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  vendor
  admin
  association
}

enum SiteStatus {
  available
  allocated
  inactive
}

enum ApplicationStatus {
  pending
  approved
  rejected
  withdrawn
  revoked
}

enum Outcome {
  approved
  rejected
  revoked
}

enum FlagStatus {
  open
  upheld
  dismissed
}

model User {
  id           String   @id @default(uuid())
  fullName     String   @map("full_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(vendor)
  trade        String?
  phone        String?
  organisation String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  applications  Application[]
  flags         Flag[]
  notifications Notification[]
  documents     Document[]

  @@map("users")
}

model Site {
  id        String     @id @default(uuid())
  reference String     @unique
  name      String
  district  String
  sector    String
  type      String
  size      String
  fee       Int
  latitude  Decimal    @db.Decimal(9, 6)
  longitude Decimal    @db.Decimal(9, 6)
  terms     String
  status    SiteStatus @default(available)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  applications Application[]
  allocations  Allocation[]

  @@index([district, status])
  @@map("sites")
}

model Application {
  id        String            @id @default(uuid())
  siteId    String            @map("site_id")
  vendorId  String            @map("vendor_id")
  statement String?
  status    ApplicationStatus @default(pending)
  appliedAt DateTime          @default(now()) @map("applied_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  site        Site         @relation(fields: [siteId], references: [id])
  vendor      User         @relation(fields: [vendorId], references: [id])
  allocations Allocation[]

  @@unique([siteId, vendorId])
  @@index([siteId, appliedAt])
  @@map("applications")
}

// Insert-only log: a database trigger rejects UPDATE and DELETE.
model Allocation {
  id             String   @id @default(uuid())
  siteId         String   @map("site_id")
  applicationId  String   @map("application_id")
  outcome        Outcome
  reason         String
  reasonCategory String   @default("other") @map("reason_category")
  queuePosition  Int      @default(0) @map("queue_position")
  waitingCount   Int      @default(0) @map("waiting_count")
  outOfOrder     Boolean  @default(false) @map("out_of_order")
  decidedById    String   @map("decided_by_id")
  decidedAt      DateTime @default(now()) @map("decided_at")

  site        Site        @relation(fields: [siteId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])
  flags       Flag[]

  @@index([siteId, decidedAt])
  @@map("allocations")
}

model Flag {
  id           String     @id @default(uuid())
  allocationId String     @map("allocation_id")
  vendorId     String     @map("vendor_id")
  category     String
  note         String
  status       FlagStatus @default(open)
  reviewNote   String?    @map("review_note")
  dueAt        DateTime   @map("due_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  reviewedAt   DateTime?  @map("reviewed_at")

  allocation Allocation @relation(fields: [allocationId], references: [id])
  vendor     User       @relation(fields: [vendorId], references: [id])

  @@map("flags")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@map("notifications")
}

model Document {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  kind      String
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("documents")
}
